    },
    {
      "id": "3458764574182824013",
      "type": "text",
      "x": 1063.698768909984,
      "y": -734.7682963293354,
      "width": 213.4285714285716,
      "height": 60,
      "text": "Bueno para amplicar pulsando sobre geometria y ampliar justo en la parte requerida",
      "fontSize": 14,
