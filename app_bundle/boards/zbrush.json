    },
    {
      "id": "3458764574182741552",
      "type": "text",
      "x": 1080.1813415343067,
      "y": -948.6244266421111,
      "width": 216.54971198039334,
      "height": 160,
      "text": "Rotate\nRight-Click + Drag\n\n\nMove\nAlt + Right-click + Drag\n\n\nZoom\nCtrl + Right-click + Drag",
      "fontSize": 14,
      "fillColor": null,
      "color": "#1a1a1a",
      "textAlign": "left"
    },
    {
      "id": "3458764574182608561",
      "type": "text",
      "x": 810.6234989086238,
      "y": -948.6244266421111,
      "width": 216.54971198039334,
      "height": 260,
      "text": "Rotate\nClick and drag back ground\n\n\nMove\nAlt + Click + Drag Background\n\n\nZoom\nAlt + Click + Drag, Release Alt\n\n\nConstrain\nClick + Drag, Hold Sift",
      "fontSize": 14,
      "fillColor": null,
      "color": "#1a1a1a",
      "textAlign": "left"
    },
